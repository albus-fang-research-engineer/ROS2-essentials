From f8b3e124af5dda0dbb514f8d5b3fbfe564289b08 Mon Sep 17 00:00:00 2001
From: Albus <albus@example.com>
Date: Wed, 19 Aug 2026 21:28:16 +0000
Subject: [PATCH] Fix: serial_no:= with an empty value is a launch parse error

CAMERA_SERIAL is empty by default ('use whichever camera is plugged in'), so
compose expanded 'serial_no:=${CAMERA_SERIAL:-}' to the bare token
'serial_no:=' and ros2 launch rejected the whole command line.

An optional launch argument has to be the entire token or absent -- there is
no empty-value form. Replace it with CAMERA_EXTRA_ARGS, passed through
verbatim and expanding to nothing when unset.

Documents the leading-underscore quirk for serials while we are here: they are
all digits, so without it the launch parser coerces the value to a number.
---
 README.md                 |  5 +++++
 cells/example-ur5e-01.env | 12 ++++++++++--
 docker-compose.yml        |  2 +-
 3 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/README.md b/README.md
index 93c5567..0905846 100644
--- a/README.md
+++ b/README.md
@@ -223,6 +223,11 @@ not surface until a grasp misses.
   show `/base_link`; that is ROS 1 legacy and ROS 2 `tf2` rejects it.
 - **UR frames.** `base_link` is the URDF root; `base` is the ROS-Industrial
   rotated frame. Mixing them costs a 180° yaw that looks almost plausible.
+- **Launch args cannot take an empty value.** `serial_no:=` with nothing after
+  it is a parse error, not an omission — so any optional launch argument must
+  be passed as a whole token (`CAMERA_EXTRA_ARGS`), never as a variable that
+  expands to nothing inside one. Camera serials also need a leading underscore
+  (`serial_no:=_912112073098`) or the parser reads them as numbers.
 - **Never solve for an optical frame.** The camera driver already publishes
   `camera_link -> camera_color_frame -> camera_color_optical_frame`. If the
   calibration targets the optical frame and you publish that result, the
diff --git a/cells/example-ur5e-01.env b/cells/example-ur5e-01.env
index 6da8620..a3a28c0 100644
--- a/cells/example-ur5e-01.env
+++ b/cells/example-ur5e-01.env
@@ -44,8 +44,16 @@ MOVEIT_RVIZ=true
 
 # --- camera ----------------------------------------------------------------
 CAMERA_NAME=camera
-# Leave empty for "whichever one is plugged in". Set it once you have two.
-CAMERA_SERIAL=
+# Extra launch args passed through verbatim. Left empty for "whichever camera
+# is plugged in". A launch arg cannot take an empty value -- `serial_no:=`
+# with nothing after it is a parse error -- so the whole token lives here
+# rather than being a separate variable that expands to nothing.
+#
+# Once you have two cameras on one host, set it like this. The leading
+# underscore is deliberate: serials are all digits, and without it the launch
+# parser coerces the value to a number and drops leading zeros.
+#   CAMERA_EXTRA_ARGS=serial_no:=_912112073098
+CAMERA_EXTRA_ARGS=
 RGB_PROFILE=1280x720x30
 ENABLE_DEPTH=true
 ALIGN_DEPTH=true
diff --git a/docker-compose.yml b/docker-compose.yml
index f0227a5..0adccf0 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -117,11 +117,11 @@ services:
     command: >
       ros2 launch realsense2_camera rs_launch.py
         camera_name:=${CAMERA_NAME:-camera}
-        serial_no:=${CAMERA_SERIAL:-}
         rgb_camera.profile:=${RGB_PROFILE:-1280x720x30}
         enable_depth:=${ENABLE_DEPTH:-true}
         align_depth.enable:=${ALIGN_DEPTH:-true}
         pointcloud.enable:=false
+        ${CAMERA_EXTRA_ARGS:-}
 
   # ======================================================================
   # profile: calib   (producer -- runs a few times a year, interactive)
-- 
