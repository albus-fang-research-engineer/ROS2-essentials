<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pin Cyclone to one interface. On a bench with a robot NIC and a lab NIC,
  leaving this to autodetection means discovery intermittently binds the wrong
  one and nodes stop seeing each other for no visible reason.

  Set NetworkInterfaceAddress to the interface facing the OTHER ROS machines
  (usually the lab LAN), not the robot's private link.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default" multicast="default" />
        <!-- Replace the line above with an explicit interface once known: -->
        <!-- <NetworkInterface name="eno1" priority="default" multicast="default" /> -->
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <!--
      SOCKET RECEIVE BUFFER. Read both paragraphs before touching either number.

      `min` is a HARD requirement. If the kernel will not grant it, Cyclone
      fails to create the domain and every node dies with the deeply unhelpful
      "rmw_create_node: failed to create domain, error Error". The kernel caps
      what it will grant at net.core.rmem_max, which defaults to 212992 bytes.
      An earlier version of this file asked for 10MB against that default and
      bricked the whole stack; the fix then was to delete the request, which
      traded a loud failure for a silent one.

      Raising net.core.rmem_max alone does NOT help. It is only a ceiling on
      what setsockopt(SO_RCVBUF) is permitted to grant; absent a request,
      every socket still comes up at net.core.rmem_default. You need the host
      sysctl AND this block. Run `make host-tune` (or see README) first.

      Why it matters: 1280x720 rgb8 is 2.76 MB per sample. Cyclone fragments
      that into ~43 datagrams of MaxMessageSize each, arriving as one burst,
      30 times a second. A 212992-byte buffer holds three of them. Everything
      else is dropped by the kernel before Cyclone reads it, and one lost
      fragment discards the WHOLE sample. Reliable readers survive on
      retransmits at a degraded rate; BEST_EFFORT readers (rviz's Image
      display, correctly) get one frame at startup and then nothing at all.

      min=4MB is deliberately well under the 16MB ceiling so that a machine
      which has not been tuned degrades to a warning from `make doctor`
      instead of reproducing the domain-creation failure above.
    -->
    <Internal>
      <SocketReceiveBufferSize min="4MB" max="16MB"/>
    </Internal>
    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>
