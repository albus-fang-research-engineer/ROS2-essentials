<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pin Cyclone to one interface. On a bench with a robot NIC and a lab NIC,
  leaving this to autodetection means discovery intermittently binds the wrong
  one and nodes stop seeing each other for no visible reason.

  Set NetworkInterfaceAddress to the interface facing the OTHER ROS machines
  (usually the lab LAN), not the robot's private link.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default" multicast="default" />
        <!-- Replace the line above with an explicit interface once known: -->
        <!-- <NetworkInterface name="eno1" priority="default" multicast="default" /> -->
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <!--
      NO SOCKET BUFFER MINIMUM HERE, ON PURPOSE.

      A `min` is a hard requirement: if the kernel will not grant it, Cyclone
      fails to create the domain and every node dies with the deeply unhelpful
      "rmw_create_node: failed to create domain, error Error". The kernel caps
      it at net.core.rmem_max, which defaults to roughly 425 KB, far below the
      10 MB that used to be requested here.

      Large image topics genuinely do benefit from a bigger buffer. If you see
      dropped frames on the colour stream, raise the CEILING on the host
      instead of demanding a floor in this file:

          sudo sysctl -w net.core.rmem_max=16777216

      On a shared machine that affects everyone and does not survive a reboot,
      so treat it as a deliberate step rather than a default. Without a `min`,
      Cyclone simply takes what it can get.
    -->
    <Tracing>
      <Verbosity>warning</Verbosity>
      <OutputFile>stderr</OutputFile>
    </Tracing>
  </Domain>
</CycloneDDS>
