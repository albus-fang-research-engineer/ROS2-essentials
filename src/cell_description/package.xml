<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cell_description</name>
  <version>0.1.0</version>
  <description>
    Single source of truth for a robot cell's static geometry: every calibrated
    extrinsic in the cell, published as static TF. Consumed by MoveIt, rviz,
    and the ZMQ perception sidecars alike.
  </description>
  <maintainer email="albus@example.com">Albus</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
