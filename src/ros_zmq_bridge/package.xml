<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros_zmq_bridge</name>
  <version>0.1.0</version>
  <description>
    The single node that speaks ROS on behalf of the CUDA perception sidecars.
    Serves synchronised colour + depth + intrinsics + TF snapshots over ZMQ so
    the sidecars never need rclpy.
  </description>
  <maintainer email="albus@example.com">Albus</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
