# ===========================================================================
# Cell config. One file per physical machine; .env is a symlink to one of them.
# `make setup` creates and links this for you based on hostname.
#
# The repo is identical on every bench. THIS FILE is the machine's identity.
# ===========================================================================

CELL_NAME=example-ur5e-01

# Which modules this machine runs. This is the whole point of the profile
# layout: the manipulator bench and the perception box share a repo and differ
# only on this line.
#   ur,camera,cell        manipulator bench, normal operation
#   ur,camera,calib,viz   same bench, calibration day
#   perception,cell       GPU box
COMPOSE_PROFILES=ur,camera,cell

# NOTE: these are R2E_* rather than ROS_DISTRO / ROS_DOMAIN_ID / etc. on
# purpose. A shell with ROS sourced exports those names, and both make and
# docker compose let an exported shell variable beat a default OR this file.
# They are renamed to ROS_* only inside the containers.
TAG=dev
R2E_DISTRO=humble
HOST_UID=1000
HOST_GID=1000

# --- DDS -------------------------------------------------------------------
# Pick a per-cell domain id so two benches on one lab LAN do not discover each
# other and fight over /joint_states.
R2E_DOMAIN_ID=42
R2E_RMW=rmw_cyclonedds_cpp
# With a robot NIC and a lab NIC on the same host, discovery will otherwise
# pick one at random, intermittently, which is a miserable bug to chase.
R2E_CYCLONEDDS_URI=file:///config/cyclonedds.xml

# --- robot -----------------------------------------------------------------
UR_TYPE=ur5e
ROBOT_IP=192.168.1.102
UR_HEADLESS=true
UR_KINEMATICS_FILE=/config/ur_kinematics.yaml
ROBOT_BASE_FRAME=base_link
ROBOT_EE_FRAME=tool0
MOVEIT_RVIZ=true

# --- camera ----------------------------------------------------------------
CAMERA_NAME=camera
# Extra launch args passed through verbatim. Left empty for "whichever camera
# is plugged in". A launch arg cannot take an empty value -- `serial_no:=`
# with nothing after it is a parse error -- so the whole token lives here
# rather than being a separate variable that expands to nothing.
#
# Once you have two cameras on one host, set it like this. The leading
# underscore is deliberate: serials are all digits, and without it the launch
# parser coerces the value to a number and drops leading zeros.
#   CAMERA_EXTRA_ARGS=serial_no:=_912112073098
CAMERA_EXTRA_ARGS=
# QoS for the image publishers. Empty = the driver's default (reliable), which
# is wrong for a camera: it makes a slow subscriber able to stall the driver.
# The parameter NAME moved between realsense-ros 4.x releases, so confirm it
# against your image before setting this:
#   docker exec -it $CELL_NAME_camera bash -lc 'ros2 param list /camera/camera | grep -i qos'
# Then pass it as a WHOLE token, e.g.
#   CAMERA_QOS_ARGS=color_qos:=SENSOR_DATA
# Note: after this, `ros2 topic echo` on the colour topic needs
#   --qos-reliability best_effort   or it will sit there printing nothing.
CAMERA_QOS_ARGS=
RGB_PROFILE=1280x720x30
ENABLE_DEPTH=true
ALIGN_DEPTH=true
CAMERA_OPTICAL_FRAME=camera_color_optical_frame
# Root of the camera driver's OWN tf subtree. The calibration solves for THIS
# frame, not the optical one. Publishing base_link -> camera_color_optical_frame
# would give that optical frame a second parent (the driver is already its
# parent) and break the tf tree.
CAMERA_TF_ROOT=camera_link
IMAGE_TOPIC=/camera/camera/color/image_raw
DEPTH_TOPIC=/camera/camera/aligned_depth_to_color/image_raw
CAMERA_INFO_TOPIC=/camera/camera/color/camera_info

# --- calibration target ----------------------------------------------------
MARKER_ID=582
# METRES, measured on the printed sheet. Printer scaling lies; a 2% size error
# is a 2% range bias that no amount of extra samples will average out.
MARKER_SIZE=0.05
MARKER_FRAME=aruco_marker_frame

# --- calibration -----------------------------------------------------------
# eye_on_base: camera fixed to the world, marker on the flange
# eye_in_hand: camera on the flange, marker fixed to the table
CALIB_TYPE=eye_on_base
CALIB_NAME=ur5e_d435_eob
FREEHAND=true

# --- perception bridge -----------------------------------------------------
BRIDGE_BIND=tcp://0.0.0.0:5680

# --- viz -------------------------------------------------------------------
RVIZ_CONFIG=cell.rviz
