# cp .env.example .env  and edit.
# Generate UID/GID with:  echo "HOST_UID=$(id -u)"; echo "HOST_GID=$(id -g)"

ROS_DISTRO=humble
HOST_UID=1000
HOST_GID=1000
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# If the box has both a robot NIC and a LAN NIC, pin Cyclone to one of them,
# otherwise discovery will occasionally pick the wrong interface:
# CYCLONEDDS_URI=file:///config/cyclonedds.xml

# --- robot ---
UR_TYPE=ur5e
ROBOT_IP=192.168.1.102
UR_HEADLESS=true
UR_KINEMATICS_FILE=/config/ur5e_calibration.yaml
ROBOT_BASE_FRAME=base_link
ROBOT_EE_FRAME=tool0

# --- camera ---
RGB_PROFILE=1280x720x30
ENABLE_DEPTH=true
CAMERA_OPTICAL_FRAME=camera_color_optical_frame

# --- target ---
# marker_size is the black square edge length in METRES. Measure it on the
# printed sheet; do not trust the nominal value from the generator.
MARKER_ID=582
MARKER_SIZE=0.05
MARKER_FRAME=aruco_marker_frame

# --- calibration ---
# eye_on_base  -> camera fixed to the world, marker on the flange
# eye_in_hand  -> camera on the flange, marker fixed to the table
CALIB_TYPE=eye_on_base
CALIB_NAME=ur5e_d435_eob
FREEHAND=true
