# colcon artefacts from the bind-mounted workspace
build/
install/
log/
__pycache__/
*.pyc
*.egg-info/

# machine-local symlink created by scripts/setup_cell.sh
/.env

# extracted from the controller, machine-specific, regenerate with `make kinematics`
/config/ur_kinematics.yaml

# NOT ignored: calibrations/. Calibration results are data. Commit them,
# date-stamp them, never overwrite them.
#
# Except calibrations/_raw/, which is only where easy_handeye2 drops its output
# so the host can reach it. `make promote` archives a date-stamped copy into
# calibrations/<cell>/, and that copy is the record worth keeping.
/calibrations/_raw/

# patch files live outside the repo
*.patch
marker_sheet.png
rosbags/