From 660f13e4badf3ab35ffe6ae16aecafae2f0695e4 Mon Sep 17 00:00:00 2001
From: Albus <albus@example.com>
Date: Wed, 19 Aug 2026 01:42:42 +0000
Subject: [PATCH] Fix: dangling overlay symlinks, and an undeclared aruco_ros
 parameter

overlay-build used --symlink-install and then deleted build/ to slim the
image. With --symlink-install, install/ is symlinks INTO build/, so every
shell in the calibration image printed 'not found: .../local_setup.bash' and
easy_handeye2's python modules never reached PYTHONPATH -- the GUI would have
failed to import. Plain colcon build for baked-in overlays; ws-build keeps
--symlink-install, which is correct for the bind-mounted workspace.

tracker.launch.py passed corner_refinement, which this aruco_ros does not
declare (it has detection_mode and min_marker_size). An undeclared parameter
makes the node refuse to start.
---
 docker/common/overlay-build                  |  8 +++++++-
 src/handeye_bringup/launch/tracker.launch.py | 12 +++++++++---
 2 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/docker/common/overlay-build b/docker/common/overlay-build
index d5b6024..f043450 100755
--- a/docker/common/overlay-build
+++ b/docker/common/overlay-build
@@ -18,6 +18,12 @@ vcs import src < "${REPOS_FILE}"
 sudo apt-get update
 rosdep update --rosdistro "${ROS_DISTRO}"
 rosdep install --from-paths src --ignore-src -r -y
-colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release
+# NOT --symlink-install here. It makes install/ a set of symlinks pointing
+# into build/, so deleting build/ to slim the image leaves dangling links and
+# every shell prints "not found: .../local_setup.bash" -- and easy_handeye2's
+# python modules never land on PYTHONPATH, so the GUI fails to import.
+# ws-build DOES use --symlink-install, correctly: that workspace is
+# bind-mounted and edited, and its build/ is never deleted.
+colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release
 rm -rf "${OVERLAY_WS}/build" "${OVERLAY_WS}/log"
 sudo rm -rf /var/lib/apt/lists/*
diff --git a/src/handeye_bringup/launch/tracker.launch.py b/src/handeye_bringup/launch/tracker.launch.py
index 80d0a0b..1a28783 100644
--- a/src/handeye_bringup/launch/tracker.launch.py
+++ b/src/handeye_bringup/launch/tracker.launch.py
@@ -22,8 +22,13 @@ ARGS = [
      'rejects them, and upstream docs still show the ROS 1 style.'),
     ('image_topic', '/camera/camera/color/image_raw', 'Rectified colour image.'),
     ('camera_info_topic', '/camera/camera/color/camera_info', 'Intrinsics.'),
-    ('corner_refinement', 'LINES',
-     'NONE | HARRIS | LINES | SUBPIX. LINES is a good default for calibration.'),
+    ('detection_mode', '',
+     'DM_NORMAL | DM_FAST | DM_VIDEO_FAST. Empty = the node default (normal). '
+     'NOTE: this node declares detection_mode, NOT corner_refinement -- '
+     'passing an undeclared parameter makes the node refuse to start.'),
+    ('min_marker_size', '0.02',
+     'Minimum marker area as a fraction of the image. Raise it to reject '
+     'far-away false positives.'),
 ]
 
 
@@ -45,7 +50,8 @@ def generate_launch_description():
             'reference_frame': LaunchConfiguration('camera_optical_frame'),
             'camera_frame': LaunchConfiguration('camera_optical_frame'),
             'marker_frame': LaunchConfiguration('marker_frame'),
-            'corner_refinement': LaunchConfiguration('corner_refinement'),
+            'detection_mode': LaunchConfiguration('detection_mode'),
+            'min_marker_size': LaunchConfiguration('min_marker_size'),
         }],
         remappings=[
             ('/camera_info', LaunchConfiguration('camera_info_topic')),
