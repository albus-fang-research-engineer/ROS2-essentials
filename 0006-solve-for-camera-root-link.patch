From e2e33851054b4035b9fcd0ef0edd6d2570d3e243 Mon Sep 17 00:00:00 2001
From: Albus <albus@example.com>
Date: Wed, 19 Aug 2026 01:47:15 +0000
Subject: [PATCH] Solve for the camera driver's root link, not its optical
 frame

Publishing base_link -> camera_color_optical_frame gives that frame a second
parent: the RealSense driver already publishes camera_link -> camera_color_frame
-> camera_color_optical_frame. TF is a tree, so the two publishers fight and
the driver's subtree is effectively orphaned.

aruco_ros separates camera_frame (which optical frame the intrinsics describe)
from reference_frame (which frame the pose is reported in). Point
reference_frame at camera_link and the calibration solves base_link ->
camera_link directly, attaching at the root of the driver's subtree. No
composing out the driver's internal extrinsics by hand, and switching between
the colour and depth optical frames costs nothing.

New CAMERA_TF_ROOT (default camera_link) drives both the tracker's
reference_frame and easy_handeye2's tracking_base_frame, so they cannot drift
apart. promote_calibration.py now refuses an optical-frame child outright,
with --allow-optical-child for the case where you composed it out yourself.
---
 README.md                                     | 10 +++++++
 cells/example-ur5e-01.env                     |  5 ++++
 docker-compose.yml                            |  3 +-
 scripts/promote_calibration.py                | 20 +++++++++++++
 .../launch/calibrate.launch.py                |  9 ++++--
 src/handeye_bringup/launch/tracker.launch.py  | 30 +++++++++++++++++--
 6 files changed, 71 insertions(+), 6 deletions(-)

diff --git a/README.md b/README.md
index b09bc77..b190ec1 100644
--- a/README.md
+++ b/README.md
@@ -121,6 +121,16 @@ docker compose --profile cell up -d --force-recreate cell
   show `/base_link`; that is ROS 1 legacy and ROS 2 `tf2` rejects it.
 - **UR frames.** `base_link` is the URDF root; `base` is the ROS-Industrial
   rotated frame. Mixing them costs a 180° yaw that looks almost plausible.
+- **Never solve for an optical frame.** The camera driver already publishes
+  `camera_link -> camera_color_frame -> camera_color_optical_frame`. If the
+  calibration targets the optical frame and you publish that result, the
+  optical frame gets a second parent, TF stops being a tree, and lookups go
+  non-deterministic. `aruco_ros` separates `camera_frame` (intrinsics /
+  projection) from `reference_frame` (what the pose is reported in), so
+  `CAMERA_TF_ROOT=camera_link` makes the solve target the driver's root link
+  directly — no post-hoc composition, and nothing to redo if you switch
+  between the colour and depth optical frames. `promote_calibration.py`
+  refuses to write an optical-frame child.
 - **Measure the marker.** `MARKER_SIZE` is the black square edge in metres, and
   printers lie about scale. A 2% size error is a 2% range bias no number of
   extra samples will average away.
diff --git a/cells/example-ur5e-01.env b/cells/example-ur5e-01.env
index e2bfaf4..6da8620 100644
--- a/cells/example-ur5e-01.env
+++ b/cells/example-ur5e-01.env
@@ -50,6 +50,11 @@ RGB_PROFILE=1280x720x30
 ENABLE_DEPTH=true
 ALIGN_DEPTH=true
 CAMERA_OPTICAL_FRAME=camera_color_optical_frame
+# Root of the camera driver's OWN tf subtree. The calibration solves for THIS
+# frame, not the optical one. Publishing base_link -> camera_color_optical_frame
+# would give that optical frame a second parent (the driver is already its
+# parent) and break the tf tree.
+CAMERA_TF_ROOT=camera_link
 IMAGE_TOPIC=/camera/camera/color/image_raw
 DEPTH_TOPIC=/camera/camera/aligned_depth_to_color/image_raw
 CAMERA_INFO_TOPIC=/camera/camera/color/camera_info
diff --git a/docker-compose.yml b/docker-compose.yml
index a3ca440..f0227a5 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -142,6 +142,7 @@ services:
         marker_size:=${MARKER_SIZE:-0.05}
         marker_frame:=${MARKER_FRAME:-aruco_marker_frame}
         camera_optical_frame:=${CAMERA_OPTICAL_FRAME:-camera_color_optical_frame}
+        camera_ref_frame:=${CAMERA_TF_ROOT:-camera_link}
         image_topic:=${IMAGE_TOPIC:-/camera/camera/color/image_raw}
         camera_info_topic:=${CAMERA_INFO_TOPIC:-/camera/camera/color/camera_info}
 
@@ -156,7 +157,7 @@ services:
         name:=${CALIB_NAME:-default_eob}
         robot_base_frame:=${ROBOT_BASE_FRAME:-base_link}
         robot_effector_frame:=${ROBOT_EE_FRAME:-tool0}
-        tracking_base_frame:=${CAMERA_OPTICAL_FRAME:-camera_color_optical_frame}
+        tracking_base_frame:=${CAMERA_TF_ROOT:-camera_link}
         tracking_marker_frame:=${MARKER_FRAME:-aruco_marker_frame}
         freehand_robot_movement:=${FREEHAND:-true}
 
diff --git a/scripts/promote_calibration.py b/scripts/promote_calibration.py
index 42f270e..4d1a438 100755
--- a/scripts/promote_calibration.py
+++ b/scripts/promote_calibration.py
@@ -103,6 +103,9 @@ def main() -> int:
                     default=REPO_ROOT / 'calibrations')
     ap.add_argument('--calibration-type', default=None,
                     help='Override if the .calib does not record it.')
+    ap.add_argument('--allow-optical-child', action='store_true',
+                    help='Promote even if the child is an optical frame. Only '
+                         'correct if you composed out the driver extrinsics.')
     ap.add_argument('--dry-run', action='store_true')
     args = ap.parse_args()
 
@@ -131,6 +134,23 @@ def main() -> int:
           f'{float(t["z"]):+.4f}   (|t| = {dist:.4f} m)')
     print(f'  rotation     {qx:+.5f} {qy:+.5f} {qz:+.5f} {qw:+.5f}')
 
+    # Refuse to promote a result that would give the camera driver's optical
+    # frame a second parent. TF is a tree; the driver already publishes
+    # camera_link -> ... -> *_optical_frame, so attaching there makes lookups
+    # non-deterministic and orphans the driver's subtree. Solve for the
+    # driver's ROOT link instead (set CAMERA_TF_ROOT / camera_ref_frame).
+    if child.endswith('_optical_frame'):
+        return err(
+            f'refusing to promote: child frame is {child}\n'
+            f'  The camera driver already publishes a parent for that frame,\n'
+            f'  and TF allows only one. Re-run the calibration with\n'
+            f'  camera_ref_frame / CAMERA_TF_ROOT set to the driver\'s root\n'
+            f'  link (camera_link for RealSense) so the solve targets that.\n'
+            f'  Override with --allow-optical-child only if you have already\n'
+            f'  composed out the driver\'s internal extrinsics yourself.'
+        ) if not args.allow_optical_child else print(
+            f'  WARN: promoting with child={child} as explicitly requested')
+
     # A camera 4 m from the robot base, or 2 cm from it, is almost always a
     # frame-convention mistake rather than a real measurement.
     if dist < 0.02 or dist > 4.0:
